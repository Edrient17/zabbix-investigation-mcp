# Zabbix
ZABBIX_URL=https://zabbix.example.com/api_jsonrpc.php
ZABBIX_API_TOKEN=
ZABBIX_API_TIMEOUT_MS=20000
ZABBIX_ALLOWED_HOST_GROUP_IDS=

# MCP server
# MCP_HOST binds the process itself. Under docker compose it is forced to
# 0.0.0.0 inside the container and MCP_BIND_ADDRESS controls host exposure.
MCP_HOST=0.0.0.0
MCP_PORT=3000
MCP_PUBLISHED_PORT=3000
# Host interface the container port is published on. Use the private address of
# this machine so the MCP is unreachable from the public interface. 0.0.0.0
# publishes on every interface, including public ones.
MCP_BIND_ADDRESS=127.0.0.1
MCP_PATH=/mcp
MCP_ALLOWED_HOSTS=
ZABBIX_MCP_AUTH_TOKEN=

# Query policies
INVESTIGATION_MAX_WINDOW_HOURS=26
# Must exceed the longest calendar month for a monthly report to be possible.
INVESTIGATION_LONG_TERM_MAX_DAYS=32
INVESTIGATION_MAX_EVENTS=100
INVESTIGATION_MAX_ITEMS_PER_CALL=20
INVESTIGATION_MAX_HISTORY_POINTS=1000
INVESTIGATION_MAX_SOURCE_POINTS=50000
INVESTIGATION_MAX_FUTURE_HOURS=2
# Results whose coverage_ratio falls below this are reported as partial=true.
INVESTIGATION_MIN_COVERAGE_RATIO=0.95

# Application
DEFAULT_TIMEZONE=Asia/Seoul
LOG_LEVEL=info
